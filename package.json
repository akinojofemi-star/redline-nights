{
  "name": "redline-nights",
  "productName": "Redline Nights",
  "version": "1.6.1",
  "description": "Arcade street racer with LAN and online multiplayer",
  "main": "main.js",
  "author": "Redline Nights",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "prepare-game": "node tools/prepare.js",
    "start": "node tools/prepare.js && electron .",
    "dist:mac": "node tools/prepare.js && electron-builder --mac",
    "dist:win": "node tools/prepare.js && electron-builder --win",
    "dist:linux": "node tools/prepare.js && electron-builder --linux",
    "dist:all": "node tools/prepare.js && electron-builder --mac --win --linux",
    "build:web": "node tools/build-web.js"
  },
  "build": {
    "appId": "com.redlinenights.game",
    "productName": "Redline Nights",
    "files": [
      "main.js",
      "lan.js",
      "preload.js",
      "app/**/*",
      "!app/duo.html"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.racing-games",
      "identity": "-",
      "hardenedRuntime": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Game"
    }
  },
  "dependencies": {
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "three": "^0.128.0"
  }
}
